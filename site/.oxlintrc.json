{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "promise", "oxc"],
  "categories": { "correctness": "error", "suspicious": "error" },
  "options": { "typeAware": true },
  "env": { "browser": true, "es2022": true },
  "rules": {
    // Bad practice worth an error. `x == null` stays legal: it is the one-check idiom for null or undefined.
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-var": "error",
    "prefer-const": "error",
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "typescript/no-explicit-any": "error",
    // Backlog, held at its current count by --max-warnings in `npm run lint`: `querySelector(...)!` in the page scripts.
    "typescript/no-non-null-assertion": "warn",
    // The `$<T>(selector)` helpers are the DOM idiom for a typed query.
    "typescript/no-unnecessary-type-parameters": "off",
    // Backlog, held by --max-warnings: casts of `dataset` values and event targets.
    "typescript/no-unsafe-type-assertion": "warn",
    // Stylesheets are imported for their effect.
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
    "typescript/consistent-type-imports": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "import/no-duplicates": "error",
    "import/no-cycle": "error",
    "promise/no-return-wrap": "error",
    "promise/no-nesting": "error",
    "promise/param-names": "error",

    // Size limits, set to the tightest the code passes today; a file that needs more gets a named override below. Split the code before raising a number.
    "max-lines": ["error", { "max": 189 }],
    "max-lines-per-function": ["error", { "max": 181 }],
    "max-params": ["error", { "max": 5 }],
    "complexity": ["error", { "max": 20 }],
    "max-depth": ["error", { "max": 4 }],
    "max-nested-callbacks": ["error", { "max": 3 }]
  },
  "overrides": [
    {
      "files": ["tools/**", "scripts/**"],
      "rules": { "no-console": "off" }
    },
    {
      // node:test registers each test and the runner awaits it.
      "files": ["tests/**"],
      "rules": { "typescript/no-floating-promises": "off" }
    },
    {
      "files": ["src/heart3d.ts"],
      "rules": { "max-lines": ["error", { "max": 340 }] }
    },
    {
      "files": ["src/app-mock.ts"],
      "rules": {
        "max-lines": ["error", { "max": 301 }],
        "max-lines-per-function": ["error", { "max": 252 }],
        "max-nested-callbacks": ["error", { "max": 4 }]
      }
    },
    {
      "files": ["tests/how.test.mjs"],
      "rules": { "max-lines": ["error", { "max": 341 }] }
    },
    {
      "files": ["src/effects-core.mjs"],
      "rules": { "max-params": ["error", { "max": 10 }] }
    }
  ],
  "ignorePatterns": ["dist", "node_modules", "src/generated", "public", ".wrangler"]
}
