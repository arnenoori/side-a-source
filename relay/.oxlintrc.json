{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "promise", "vitest", "oxc"],
  "categories": { "correctness": "error", "suspicious": "error" },
  "options": { "typeAware": true },
  "rules": {
    // Bad practice worth an error. `x == null` stays legal: it is the one-check idiom for null or undefined.
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-var": "error",
    "prefer-const": "error",
    // Logs are one JSON line through console.log or console.error (the Workers observability format).
    "no-console": ["error", { "allow": ["log", "error"] }],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "import/no-duplicates": "error",
    "import/no-cycle": "error",
    "promise/no-return-wrap": "error",
    "promise/no-nesting": "error",
    "promise/param-names": "error",
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],

    // Size limits, set to the tightest the code passes today; a file that needs more gets a named override below. Split the code before raising a number.
    "max-lines": ["error", { "max": 377 }],
    "max-lines-per-function": ["error", { "max": 58 }],
    "max-params": ["error", { "max": 6 }],
    "complexity": ["error", { "max": 32 }],
    "max-depth": ["error", { "max": 3 }],
    "max-nested-callbacks": ["error", { "max": 1 }],

    // Off: typescript-eslint's autofix removes `as` casts that narrow from `any`, and tsc then fails.
    "typescript/no-unnecessary-type-assertion": "off",
    // Off: tsc already checks that every exhaustive switch returns.
    "typescript/consistent-return": "off",

    // Backlog, held at its current count by --max-warnings in `npm run lint`: casts from validated JSON.
    "typescript/no-unsafe-type-assertion": "warn"
  },
  "overrides": [
    {
      "files": ["test/**", "scripts/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      // Backlog in the tests: a response's JSON read as `any`, and `!` on a socket or push that the next line asserts on.
      "files": ["test/**"],
      "rules": {
        "typescript/no-explicit-any": "warn",
        "typescript/no-non-null-assertion": "warn"
      }
    },
    {
      // Tests nest describe and it callbacks, so a describe body counts as one long function.
      "files": ["test/**"],
      "rules": {
        "max-lines-per-function": ["error", { "max": 156 }],
        "max-nested-callbacks": ["error", { "max": 4 }]
      }
    },
    {
      "files": ["test/tunnel.test.ts"],
      "rules": {
        "max-lines": ["error", { "max": 620 }],
        "max-lines-per-function": ["error", { "max": 211 }]
      }
    },
    {
      "files": ["src/install.ts"],
      "rules": {
        "max-lines": ["error", { "max": 590 }],
        "max-params": ["error", { "max": 7 }]
      }
    },
    {
      "files": ["src/tunnel.ts"],
      "rules": { "max-lines": ["error", { "max": 587 }] }
    },
    {
      "files": ["src/send.ts"],
      "rules": { "complexity": ["error", { "max": 43 }] }
    }
  ],
  "ignorePatterns": ["worker-configuration.d.ts", "dist", "node_modules", ".wrangler"]
}
